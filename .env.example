PUBLIC_SUPABASE_URL=http://127.0.0.1:57321
PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-the-key-from-npm-run-db-status

# `npm run env:local` writes generated local credentials to the ignored `.env` file.
LOCAL_PILOT_ONE_EMAIL=keeper.one@example.test
LOCAL_PILOT_ONE_PASSWORD=
LOCAL_PILOT_TWO_EMAIL=keeper.two@example.test
LOCAL_PILOT_TWO_PASSWORD=
LOCAL_TEST_USER_PASSWORD=

# Server only. env:local supplies the local service key and preserves custom settings.
SUPABASE_SERVICE_ROLE_KEY=

# Trusted media-operator tooling only. Prefer a hosted `sb_secret_...` key.
# Never expose either key to browser code or commit a populated value.
MEDIA_SUPABASE_URL=
MEDIA_SUPABASE_SECRET_KEY=
# Temporary compatibility alias for projects that still use the legacy key.
MEDIA_SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
NPC_PROVIDER=openai
NPC_CONTEXT_MODEL=gpt-5.6-luna
NPC_CHARACTER_MODEL=gpt-5.6-terra
NPC_MAX_CALLS=8
NPC_INVESTIGATION_ROUNDS=2
NPC_DEADLINE_MS=90000
