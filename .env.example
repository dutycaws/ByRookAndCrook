PUBLIC_SUPABASE_URL=http://127.0.0.1:57321
PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-the-key-from-pnpm-db-status

# `pnpm env:local` writes generated local credentials to the ignored `.env` file.
LOCAL_PILOT_ONE_EMAIL=keeper.one@example.test
LOCAL_PILOT_ONE_PASSWORD=
LOCAL_PILOT_TWO_EMAIL=keeper.two@example.test
LOCAL_PILOT_TWO_PASSWORD=
LOCAL_TEST_USER_PASSWORD=
